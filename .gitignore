# ── Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Fetched artifacts (fetch scripts are committed, payloads are not) ──
data/models/*
!data/models/.gitkeep
!data/models/README.md
data/videos/*
# Clips pulled out of rotation but kept on disk — same rule as data/videos.
data/videos_parked/
# Keyframe-dense copies the simulator builds from data/videos (cache, rebuildable)
data/prepared/
!data/videos/.gitkeep
!data/videos/README.md
data/synthetic/

# ── Container state ───────────────────────────────────────────
.volumes/
infra/minio/data/
infra/postgres/data/
infra/opensearch/data/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ── Node ──────────────────────────────────────────────────────
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo
npm-debug.log*

# ── Generated contracts (regenerated by `make contracts`) ─────
packages/contracts/generated/**/*.ts
packages/contracts/generated/**/*.py
!packages/contracts/generated/.gitkeep

# ── AI lab (standalone evaluation environment) ────────────────
# Weights, run outputs and mined datasets are all reproducible from the
# committed fetch script and configs; none of them belong in git.
ai-lab/models/*
!ai-lab/models/.gitkeep
ai-lab/runs/*
!ai-lab/runs/.gitkeep
ai-lab/datasets/

# ── Benchmark / load output ───────────────────────────────────
tests/load/results/
benchmarks/*.json

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Load-test output — regenerated by `make load`, and each run is a snapshot of
# one machine on one day rather than something to review in a diff.
tests/load/results/
tests/browser/out/

# TLS material for the web tier's HTTPS server (mkcert or the generated
# self-signed pair) — never committed. The directory itself is kept so the
# bind mount exists on a fresh clone.
infra/tls/*
!infra/tls/.gitkeep

# `make backup` output: plate history and face media, i.e. personal data.
backups/

# Submission renders: the walk-through video (`tests/browser/record_demo.mjs`) and
# the PDFs (`tests/browser/export_pdf.mjs`) are regenerated from the running stack
# and the committed Markdown, so neither is versioned.
docs/submission/video/
docs/submission/pdf/
