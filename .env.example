# ══════════════════════════════════════════════════════════════
#  NagarNetra — environment template
#  `make env` copies this to `.env` (gitignored) and fills every secret
#  left empty below with a generated value (scripts/gen_secrets.py), so
#  no password in a running stack appears in this repository.
#  docker-compose.yml has no fallback passwords: an empty secret stops
#  `docker compose` with "<KEY> is not set - run make env".
# ══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Kolkata                   # display timezone; storage is always UTC
COMPOSE_PROJECT_NAME=contrail

# ── PostgreSQL (PostGIS + TimescaleDB) ────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nagarnetra
POSTGRES_USER=nagarnetra
POSTGRES_PASSWORD=                  # generated by `make env`
POSTGRES_HOST_PORT=5432             # host-side port, published on 127.0.0.1 only
# Kept in step with POSTGRES_PASSWORD by `make env`; compose builds its own.
DATABASE_URL=postgresql+asyncpg://nagarnetra:@postgres:5432/nagarnetra

# ── Redis (cache + event bus, dev profile) ────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379                # published on 127.0.0.1 only
# Required by every client. The bus carries the detections alerts are raised
# from; without a password anyone on the network could XADD a fake sighting.
REDIS_PASSWORD=                     # generated by `make env`
# Kept in step with REDIS_PASSWORD by `make env`; compose builds its own.
REDIS_URL=redis://:@redis:6379/0
EVENT_STREAM_KEY=nagarnetra:events:detections
EVENT_CONSUMER_GROUP=nagarnetra-processors

# ── Event bus selection ───────────────────────────────────────
# redis  → Redis Streams (base profile, default)
# kafka  → Redpanda      (scale profile)
EVENT_BUS_BACKEND=redis
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_DETECTIONS=nagarnetra.detections

# ── MinIO / S3 object store ───────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=nagarnetra
# Generated by `make env`. Secret for a second reason: anyone holding it can
# sign their own URL, and the HTTPS server proxies signed GETs (/media/).
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=nagarnetra-media
# Reference photos and matched face crops for the persons watchlist. Kept apart
# from MINIO_BUCKET and never given an anonymous policy: read only through
# two-minute signed links from audited `person.read` endpoints.
MINIO_PERSONS_BUCKET=nagarnetra-persons
MINIO_SECURE=false
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# Browser-reachable base for presigned media URLs
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ── OpenSearch ────────────────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_HOST_PORT=9200
OPENSEARCH_INDEX_DETECTIONS=detections
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# When OpenSearch is unreachable, search falls back to Postgres pg_trgm.
SEARCH_FALLBACK_ENABLED=true

# ── MediaMTX stream gateway ───────────────────────────────────
MEDIAMTX_HOST=mediamtx
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997
# ICE host candidate advertised to the browser. Docker Desktop's NAT hands out
# unreachable candidates without this — leave as localhost for a laptop demo.
MEDIAMTX_ADDITIONAL_HOSTS=127.0.0.1
MEDIAMTX_PUBLIC_WEBRTC_URL=http://localhost:8889
MEDIAMTX_PUBLIC_HLS_URL=http://localhost:8888
# MediaMTX asks the API about every publish and read (authMethod: http).
# The simulator publishes and the ANPR workers read with these identities;
# browsers present the camera-scoped stream token instead. Generated.
MEDIAMTX_PUBLISH_USER=contrail-publisher
MEDIAMTX_PUBLISH_PASSWORD=
MEDIAMTX_READ_USER=contrail-reader
MEDIAMTX_READ_PASSWORD=
# HLS, WHEP and ICE are published on 127.0.0.1. 0.0.0.0 lets a browser on
# another machine play over plain HTTP; :8443 needs none of it.
#MEDIAMTX_HOST_BIND=127.0.0.1

# ── Auth / security ───────────────────────────────────────────
# Generated by `make env` (64 hex characters). Anyone holding it can mint an
# admin token, so it is never a value from this file.
JWT_SECRET_KEY=

# ── Encryption at rest (application level) ────────────────────────────
# AES-256-GCM for values sealed into the database, currently the enc://
# credentials_ref scheme. A ring, so a key can be rotated without
# re-encrypting everything at once: "id:base64_32_bytes,id:base64_32_bytes".
#
# Empty by default and that is a working state: the demo path uses env://
# pointers and needs no key. Nothing silently falls back to plaintext — an
# enc:// pointer with no ring configured refuses and logs.
#
#   python3 scripts/generate_encryption_key.py --key-id 2025a
#
# Keep every key you have ever sealed with, or those values become unreadable.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
STREAM_TOKEN_EXPIRE_SECONDS=120
# Seeded accounts (scripts/seed.py), one password each, all generated by
# `make env` and marked must_change_password in the database. They are in
# your .env — that file is the only place they are written.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_PASSWORD_SUPERVISOR=
DEMO_PASSWORD_OPERATOR=
DEMO_PASSWORD_ANALYST=
DEMO_PASSWORD_AUDITOR=
DEMO_PASSWORD_GSRTC_INTEGRATION=
# Who may tell the API the client's address (X-Forwarded-For). Compose pins
# it to the web tier's nginx; the default trusts loopback only.
#FORWARDED_ALLOW_IPS=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── API ───────────────────────────────────────────────────────
API_HOST_PORT=8000
API_WORKERS=1
API_BASE_URL=http://api:8000
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/events

# ── Web ───────────────────────────────────────────────────────
WEB_HOST_PORT=8080
# HTTPS on the same app. Put cert.pem + key.pem in infra/tls/ (e.g. from
# mkcert) or leave it empty for a generated self-signed pair. Extra names /
# IPs the self-signed certificate should cover, comma-separated (e.g. this
# laptop's LAN address for a second screen):
WEB_TLS_HOST_PORT=8443
TLS_SERVER_NAMES=
TLS_SERVER_IPS=

# ── AI pipeline ───────────────────────────────────────────────
AI_DEVICE=auto                    # auto | cpu | cuda
AI_TARGET_FPS=10                  # analysed frames per second per stream
AI_STREAMS_PER_WORKER=8
AI_VEHICLE_MODEL=/models/vehicle_yolo.onnx
AI_PLATE_MODEL=/models/plate_yolo.onnx
AI_OCR_MODEL=/models/plate_ocr_crnn.onnx
OCR_ENGINE=onnx_crnn              # onnx_crnn | paddle (paddle needs amd64)
# `make ai-multi` runs three worker processes, each owning a hash shard of the
# camera roster (AI_WORKER_COUNT=3). Every camera a worker owns keeps its
# stream open; AI_WORKER_MAX_CAMERAS is how many of them it analyses at once,
# rotating every AI_WORKER_SLICE_SECONDS. Each analysed camera costs about a
# core — the measurements are in docker-compose.yml beside the setting.
#
# Leave these unset to take the compose defaults. Never leave
# AILAB_INFERENCE_BUDGET blank with more than one worker process: blank means
# "cores − 2" per process, and three of those oversubscribe the machine three
# times over. AI_WORKER_CAMERAS_1/2/3 narrow a worker to an explicit list.
#AI_WORKER_MAX_CAMERAS=2
#AI_WORKER_SLICE_SECONDS=45
#AILAB_INFERENCE_BUDGET=2
# Store and forward (ai_worker/publisher.py): sightings held while the bus is
# unreachable, replayed in order when it answers. Memory bounds, then the
# disk tier on the ai-worker-spool volume. Defaults shown.
#AI_WORKER_SPOOL_MAX_EVENTS=20000
#AI_WORKER_SPOOL_MAX_BYTES=50331648
#AI_WORKER_SPOOL_DISK_MAX_BYTES=1073741824

# ── Monitoring (`make monitoring`; loopback-only ports) ───────
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                     # generated by `make env`
# A short list kept open and analysed always; any other camera is analysed
# only while it is open on the Live ANPR screen. Empty = every camera.
#AI_WORKER_ALWAYS_ON=CAM-DEMO-01,SBX-cam10,SBX-cam21,SBX-cam22
# Consensus + gating
PLATE_MIN_READS_FOR_CONSENSUS=5
DETECTION_EMIT_CONFIDENCE=0.55
ALERT_AUTO_CONFIDENCE=0.80
DUPLICATE_SUPPRESSION_SECONDS=60

# ── Correlator ────────────────────────────────────────────────
ROUTE_MAX_PLAUSIBLE_KMPH=150
ROUTE_MIN_PLAUSIBLE_KMPH=2
ROUTE_DWELL_MERGE_SECONDS=120
CONVOY_MIN_SHARED_CAMERAS=3
CONVOY_TIME_WINDOW_SECONDS=90

# ── Health monitor ────────────────────────────────────────────
HEALTH_PROBE_INTERVAL_SECONDS=15   # 2 failures x 15s = offline detected inside 30s
HEALTH_PROBE_TIMEOUT_SECONDS=5
HEALTH_OFFLINE_AFTER_FAILURES=2
# Any other status change (back online, degraded) needs this many agreeing probes.
HEALTH_STATUS_CHANGE_AFTER_PROBES=3
# One integration alarm (e.g. the grid refusing our session) opens after this many
# sweeps in which none of its cameras could be asked, and closes after the second
# number of sweeps in which it answered again (20 x 15 s = 5 min of steady answers).
HEALTH_INTEGRATION_DOWN_AFTER_SWEEPS=4
HEALTH_INTEGRATION_RECOVER_AFTER_SWEEPS=20
# A camera an AI worker decoded video from, or read a vehicle at, this recently is answering.
HEALTH_WORKER_EVIDENCE_SECONDS=120

# ── Simulator ─────────────────────────────────────────────────
SIM_CAMERA_COUNT=250
SIM_STREAM_COUNT=0                # only the pinned recorded camera below. Raise it to
                                  # replay clips into a larger registry for load testing,
                                  # where synthetic video is the point rather than a pretence.
SIM_VIDEO_DIR=/data/videos
# The recorded cameras. CAM-DEMO-01 is the ANPR fallback that still plays when
# the organisers' grid cannot be reached; CAM-DEMO-02 is the persons
# watchlist's demonstration, people walking toward a camera (the grid's junction
# cameras cannot resolve a face). Both clips are what `make videos` fetches.
# More cameras can share a clip; the simulator seeks each to a different point
# in it (see simulator.main.stagger_offset) so they never show the same instant.
SIM_CAMERA_VIDEOS=CAM-DEMO-01=anpr_demo.mp4,CAM-DEMO-02=persons_demo.mp4
# Blank spreads the cameras sharing a clip evenly across its real duration,
# which is the widest spacing the footage allows. Set a number to pin the step.
SIM_OFFSET_STEP_S=
SIM_EVENT_RATE_PER_SECOND=0       # 0 = replay-driven; >0 = synthetic injection

# ── Load / scale profile ──────────────────────────────────────
LOAD_CAMERA_COUNT=80000
LOAD_EVENTS_PER_SECOND=2667
LOAD_DURATION_SECONDS=600
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# ── Data retention (surfaced in docs/SECURITY.md) ─────────────
# Enforced daily by app/services/retention.py. Under the DPDP Act the stated
# period is the lawful basis for holding the data, so these are not advisory.
RETENTION_DETECTIONS_DAYS=365
RETENTION_MEDIA_DAYS=90
RETENTION_CAMERA_HEALTH_DAYS=90
# The audit log outlives everything it describes: it is the record of who
# looked at whom, which is what an inquiry into misuse would need.
RETENTION_AUDIT_DAYS=1825
# Set false only where an external process performs the purge. The sweep still
# runs and reports what it would have deleted, so the gap between policy and
# practice stays visible instead of silent.
RETENTION_ENFORCE=true

# ── Rate limiting ─────────────────────────────────────────────────────
# Counted in Redis, so the budget is per-deployment rather than per-replica.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
# Authentication counts *failures only*, so a shift change of successful
# logins from one control-room address cannot lock the room out.
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# ── NagarNetra camera grid ──────────────────────────────────────────────
SANDBOX_BASE_URL=https://cctv.corp8.cloud
# RTSP and WHEP are NOT behind the CDN — a CDN cannot proxy either — so they
# are served on the organisers' direct address.
SANDBOX_MEDIA_HOST=103.250.160.189
# The grid began requiring credentials on 3 Sep 2026; it was anonymous before,
# so empty is a valid configuration rather than a missing one. Put the real
# values in .env, which is gitignored. They are redacted wherever a stream URL
# is logged — anyone holding them can pull video from a government camera
# network.
SANDBOX_RTSP_USERNAME=
SANDBOX_RTSP_PASSWORD=
